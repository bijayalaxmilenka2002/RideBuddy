# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ridebuddy

# Secret used to sign JWTs. Use a long random value.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins. Scheme + host, no trailing
# slash. In production this must list the exact origin your frontend is served
# from, or the browser blocks every request.
# e.g. CORS_ORIGINS=https://ridebuddy-t4qb37.public.builtwithrocket.new
CORS_ORIGINS=http://localhost:5173

# Optional. Attribution only - RideBuddy does NOT call the Uber API.
# UBER_CLIENT_ID=

# --- Maps -------------------------------------------------------------------
# Place search and routing use free OpenStreetMap services. No API key and no
# credit card are needed, and the defaults below work out of the box.
#
# Nominatim's public server asks that you identify your app and stay under one
# request per second. The backend already enforces both; put a real contact
# address in PLACES_USER_AGENT before running this anywhere public.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# PLACES_USER_AGENT=RideBuddy/1.0 (you@example.com)

# Bias place search to one country, e.g. "in" for India. Blank searches worldwide.
# PLACES_COUNTRY_CODES=in

# Minimum milliseconds between outbound geocoding calls. Set 0 if you self-host
# Nominatim, where the one-per-second courtesy limit does not apply.
# PLACES_MIN_GAP_MS=1100
