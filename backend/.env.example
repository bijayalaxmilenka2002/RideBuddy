# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ridebuddy

# Secret used to sign JWTs. Use a long random value.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins. Scheme + host, no trailing
# slash. In production this must list the exact origin your frontend is served
# from, or the browser blocks every request.
# e.g. CORS_ORIGINS=https://ridebuddy-t4qb37.public.builtwithrocket.new
CORS_ORIGINS=http://localhost:5173

# Optional. Attribution only - RideBuddy does NOT call the Uber API.
# UBER_CLIENT_ID=
