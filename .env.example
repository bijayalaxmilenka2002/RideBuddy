# Optional overrides for `docker compose up`. Copy to .env in this folder.
# Compose reads this file automatically; the defaults in docker-compose.yml
# are fine for local development, so you usually need none of this.

# Signs the JWTs. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Comma-separated origins allowed to call the API from a browser.
# CORS_ORIGINS=http://localhost:5173
