# Copy to .env (or .env.local) and adjust. Vite only exposes VITE_* variables
# to the browser, and they are baked in at BUILD time - never put a secret here.

# Base URL of the RideBuddy API, used by both fetch and the Socket.IO client.
# Leave it unset in development to use the Vite dev proxy (same origin).
# Set it for a deployed backend, e.g. https://ridebuddy-api.onrender.com
VITE_API_URL=http://localhost:5000

# Where `npm run dev` proxies /api and /socket.io. Only needed if your backend
# is not on http://localhost:5000.
# VITE_DEV_API_TARGET=http://localhost:5000
